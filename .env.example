# ---------------------------------------------------------------------------
# Radiant Hub — Environment variables
# Copy to `.env` and fill in with your own Lovable Cloud (Supabase) project
# credentials. NEVER commit real values.
# ---------------------------------------------------------------------------

# Client-visible (bundled into the browser) — publishable keys only
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT-REF

# Server-only (read inside createServerFn / server routes)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
SUPABASE_PROJECT_ID=YOUR-PROJECT-REF

# Secret keys — MUST be set via the Lovable "Secrets" UI in production,
# never committed to git. Listed here for documentation only.
# SUPABASE_SERVICE_ROLE_KEY=service-role-key (server-only, RLS bypass)
# LOVABLE_API_KEY=auto-provisioned by Lovable Cloud (AI gateway + email)
