{
  "version": 1,
  "sdk_version": "0.23.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://fwdysvinyusuijplooex.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "hvac-pro-mcp",
      "version": "0.1.0",
      "title": "HVAC Pro"
    },
    "tools": [
      {
        "name": "get_site_info",
        "title": "Get company info",
        "description": "Get the HVAC company's public contact info: name, tagline, support phone, emergency phone, email, address, business hours.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_services",
        "title": "List HVAC services",
        "description": "List all published HVAC services offered by the company (heating, cooling, maintenance, installation).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_products",
        "title": "List HVAC products",
        "description": "List HVAC products available in the shop (units, thermostats, filters). Optionally filter by category.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "category": {
              "description": "Optional category filter, e.g. 'ac', 'furnace', 'thermostat'.",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "check_service_area",
        "title": "Check service area by ZIP",
        "description": "Check whether the HVAC company services a given US ZIP code.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "zip": {
              "type": "string",
              "pattern": "^\\d{5}$",
              "description": "US 5-digit ZIP code."
            }
          },
          "required": [
            "zip"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_my_bookings",
        "title": "List my bookings",
        "description": "List the signed-in user's HVAC service bookings, with status and scheduled date/time.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_my_orders",
        "title": "List my orders",
        "description": "List the signed-in user's product orders with items, totals, and current status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "book_service",
        "title": "Book an HVAC service",
        "description": "Book an HVAC service appointment for the signed-in user at a given date and hour (8-18, 24h). Verifies the ZIP is in the service area.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "full_name": {
              "type": "string",
              "minLength": 2,
              "maxLength": 80
            },
            "email": {
              "type": "string",
              "format": "email",
              "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
            },
            "phone": {
              "type": "string",
              "minLength": 7,
              "maxLength": 20
            },
            "street": {
              "type": "string",
              "minLength": 3,
              "maxLength": 120
            },
            "city": {
              "type": "string",
              "minLength": 2,
              "maxLength": 60
            },
            "state": {
              "type": "string",
              "minLength": 2,
              "maxLength": 20
            },
            "zip": {
              "type": "string",
              "pattern": "^\\d{5}$"
            },
            "service_slug": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 80
                },
                {
                  "type": "null"
                }
              ]
            },
            "service_name": {
              "type": "string",
              "minLength": 2,
              "maxLength": 120
            },
            "scheduled_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "YYYY-MM-DD"
            },
            "scheduled_hour": {
              "type": "integer",
              "minimum": 8,
              "maximum": 18,
              "description": "Hour 8-18 (24h)"
            },
            "notes": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 1000
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "full_name",
            "email",
            "phone",
            "street",
            "city",
            "state",
            "zip",
            "service_name",
            "scheduled_date",
            "scheduled_hour"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
